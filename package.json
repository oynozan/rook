{
  "name": "rook",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.12.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @rook/services dev",
    "live": "pnpm --filter @rook/services dev --live",
    "web": "pnpm --filter @rook/web dev",
    "rook": "pnpm --filter @rook/services --silent rook",
    "test": "pnpm --filter @rook/services test && pnpm --filter @rook/web test",
    "typecheck": "pnpm --filter @rook/services typecheck"
  }
}
