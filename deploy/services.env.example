# The services' settings and keys. Copy to deploy/services.env on the server (gitignored, never committed).
# Start from your ~/.rook/mainnet.env (written by services/scripts/deploy.ts) and add the two API keys below.
# Never put ADMIN_WALLET_PRIVATE_KEY here: no service uses it, and it controls the contract and the admin wallet.
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://free.rpc.fastnear.com
ROOK_CONTRACT_ID=rook.oynozan.near
ROOK_ORCHESTRATOR_ACCOUNT=orch.oynozan.near
ROOK_ORCHESTRATOR_KEY=ed25519:...
ROOK_SIGNER_ACCOUNT=signer.oynozan.near
ROOK_SIGNER_KEY=ed25519:...
# The same value as in deploy/web.env: the web app sends it to the orchestrator.
ROOK_SERVICE_TOKEN=...
ROOK_MARKET=live
ROOK_LEDGER=chain
ROOK_LLM=near
# NEAR AI (planner, evaluator, Rook's own work).
NEARAI_API_KEY=...
# NEAR Intents Agent API (the agent wallet). Empty: the agent wallet is off.
ROOK_AGENT_API_KEY=...
# ROOK_AGENT_API_URL=https://api.demo.agentsonintents.com
