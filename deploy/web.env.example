# The web app's secrets. Copy to deploy/web.env on the server (gitignored, never committed).
# The same value as ROOK_SERVICE_TOKEN in deploy/services.env.
ROOK_SERVICE_TOKEN=...
# Signs sign-in sessions: 32+ random characters, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
ROOK_SESSION_SECRET=...
# RPC the server checks sign-ins with (optional; defaults to NEAR's public RPC).
WEB_NEAR_RPC_URL=https://free.rpc.fastnear.com
